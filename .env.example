# ============================================================
# AI Growth Operating System - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file to version control.

# ------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=linkedin_growth
# Automatically constructed in docker-compose.yml, but can be overridden:
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# ------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------
# 3. Security
# ------------------------------------------------------------
# Must be a long, securely generated random string (e.g., from `openssl rand -hex 32`)
JWT_SECRET_KEY=your_secure_jwt_secret_key_here

# ------------------------------------------------------------
# 4. Frontend / Backend Networking
# ------------------------------------------------------------
# A JSON list of allowed origins for CORS. Include your frontend URL here.
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:80", "http://localhost"]
# The public base URL of the frontend (used for generating absolute links in emails)
FRONTEND_BASE_URL=http://localhost:80

# ------------------------------------------------------------
# 5. API Integrations
# ------------------------------------------------------------
# OpenAI API Key (Required for Strategy & Generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (Required for complex analysis/reasoning)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Cerebras API Key (Optional for ultra-fast generation)
CEREBRAS_API_KEY=your_cerebras_api_key

# Pexels API Key (Required for Visual Intelligence / Images)
PEXELS_API_KEY=your_pexels_api_key

# Resend API Key (Required for sending approval emails)
RESEND_API_KEY=re_your_resend_api_key
# The "from" address for approval emails
EMAIL_FROM_ADDRESS="AI Growth Agent <onboarding@resend.dev>"

# ------------------------------------------------------------
# 6. LinkedIn OAuth
# ------------------------------------------------------------
# Credentials from your LinkedIn Developer Console App
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# This must exactly match the authorized redirect URL in LinkedIn Developer Console
OAUTH_REDIRECT_URI=http://localhost:5173/publishing/callback
