# ============================================================
# LinkedIn Growth Agent - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Database ---
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=linkedin_growth
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/linkedin_growth

# --- Backend ---
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:3000", "http://localhost", "http://127.0.0.1"]
PROJECT_NAME="LinkedIn Growth Agent"

# --- AI Models ---
# Document analysis (large context window needed)
ANALYSIS_LLM_MODEL="groq/llama-3.1-8b-instant"
# Brand intelligence (fast JSON aggregation)
BRAND_LLM_MODEL="groq/llama-3.1-8b-instant"

# --- AI Provider API Keys (choose one or more) ---
# Groq (free tier available): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (access to many models): https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# --- LinkedIn OAuth ---
# Create an app at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
OAUTH_REDIRECT_URI=http://localhost:5173/publishing/callback

# --- Email (optional, for approval notifications) ---
# Resend: https://resend.com
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM_ADDRESS="LinkedIn Growth Agent <onboarding@resend.dev>"
FRONTEND_BASE_URL=http://localhost:5173
